  "mechanics": {
    "CHOICE_ITEM": {
      "rule": "One question, N options, one answer. The default mechanic."
    },
    "TAP_TOKEN": {
      "rule": "A token pool tapped in index order to build a string. Selection by index, never value."
    },
    "TAP_SENTENCE": {
      "rule": "A passage rendered as individually tappable sentences. Matched by sentence index."
    },
    "TILE_SEQUENCE": {
      "rule": "A word pool tapped in index order to build a sentence, with punctuation from the answer."
    },
    "TYPED_ANSWER": {
      "rule": "Free text with normalisation; optional Damerau-Levenshtein distance 1."
    },
    "SORT_BINS": {
      "rule": "Items placed into 2-4 named bins, by tap or by drag."
    },
    "TWO_PASS_AUDIO": {
      "rule": "One audio with two passes and two different jobs, gated in order."
    },
    "SPEAKING": {
      "rule": "A recorded response, scored on keyword coverage in bands."
    },
    "NOTICE": {
      "rule": "A teach card: statements plus a rule, then items that read the pattern."
    },
    "RUNNER": {
      "rule": "A heterogeneous container that dispatches per item.type."
    },
    "CHART": {
      "rule": "A writing station: optional picker, one of three chart shapes, free text, checklist."
    }
  },
